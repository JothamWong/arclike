<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test helper for the headless Windows box. It runs in the logged-on user's session through
       the ArclikeInteractive scheduled task. WinExe, so it never opens a console window that
       would take the foreground from Chrome. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
