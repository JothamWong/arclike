<Window x:Class="Arclike.Views.CommandBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arclike Command Bar"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#1C1C1C"
        Width="720" Height="62"
        AutomationProperties.AutomationId="ArclikeCommandBar">

    <Border BorderBrush="#1FFFFFFF" BorderThickness="1">
        <StackPanel>
            <!-- Search field -->
            <Grid Height="62" Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="#73FFFFFF"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0" />
                <TextBlock x:Name="Placeholder"
                           Grid.Column="1"
                           FontSize="18"
                           Foreground="#66FFFFFF"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           IsHitTestVisible="False" />
                <TextBox x:Name="Field"
                         Grid.Column="1"
                         FontSize="18"
                         Foreground="White"
                         CaretBrush="White"
                         SelectionBrush="#4D8CC8FF"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="CommandBarField" />
            </Grid>

            <Rectangle x:Name="RowsSeparator" Height="1" Fill="#14FFFFFF" Margin="12,0" Visibility="Collapsed" />
            <StackPanel x:Name="Rows" Margin="8" Visibility="Collapsed" />

            <Rectangle x:Name="TipSeparator" Height="1" Fill="#14FFFFFF" Margin="12,0" Visibility="Collapsed" />
            <Grid x:Name="TipRow" Height="34" Margin="20,0" Visibility="Collapsed"
                  AutomationProperties.AutomationId="CommandBarTip">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE82F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="TipText" Grid.Column="1" FontSize="12" Foreground="#80FFFFFF"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="TipDismiss" Grid.Column="2" Width="20" Height="20" Padding="0"
                        Background="Transparent" BorderThickness="0" Focusable="False" Cursor="Hand"
                        ToolTip="Don't show this tip again" Click="TipDismiss_Click"
                        AutomationProperties.AutomationId="CommandBarTipDismiss">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10" Foreground="#80FFFFFF" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
